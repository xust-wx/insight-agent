# 复制为 .env 后按实际填写；.env 已被 .gitignore 排除，绝不提交到 Git

# === 1. 网络代理（中国大陆访问 Gemini API 必填，出口节点须在 Google AI Studio 支持地区）===
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890

# === 2. 主模型配置（LLM_PROVIDER 可选: gemini | openai_compat）===
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_MODEL_FAST=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# === 3. 备选/降级模型配置（如 DeepSeek / 阿里云百炼 Qwen，当地区受限或配额耗尽时切换 LLM_PROVIDER=openai_compat）===
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
OPENAI_MODEL_FAST=deepseek-chat

# === 4. PostgreSQL 数据库（S1 Docker Compose 仅绑定 127.0.0.1:5432）===
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=olist
PG_ADMIN_USER=olist_admin
PG_ADMIN_PASSWORD=replace_with_local_admin_pwd
PG_READONLY_USER=readonly_analyst
PG_READONLY_PASSWORD=replace_with_local_ro_pwd

# === 5. 运行守卫与预算上限 ===
MAX_AGENT_STEPS=12
MAX_NODE_RETRIES=3
MAX_TOKENS_PER_RUN=60000
SANDBOX_TIMEOUT_SECONDS=30

# === 6. 可观测性（默认写入本地 ./traces JSONL；可选开启 Arize Phoenix 或 Langfuse Cloud）===
TRACE_DIR=./traces
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
