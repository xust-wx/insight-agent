# 复制为 .env 后按实际填写；.env 已被 .gitignore 排除，绝不提交到 Git

# === 1. 阿里云百炼（DashScope OpenAI 兼容模式，国内直连）===
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主生成模型与分级推理档位
LLM_MODEL=qwen4-max
LLM_REASONING_EFFORT_FAST=low
LLM_REASONING_EFFORT_DEEP=high

# 向量嵌入模型（注意：代码层固定发送 encoding_format="float"）
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024

# 代理旁路：确保国内百炼流量直连，不误走本机海外代理端口
NO_PROXY=localhost,127.0.0.1,dashscope.aliyuncs.com

# === 2. 可选其他 OpenAI 兼容端点（多模型对比评测用）===
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# === 3. PostgreSQL 数据库（S1 Docker Compose 仅绑定 127.0.0.1:5432）===
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=olist
PG_ADMIN_USER=olist_admin
PG_ADMIN_PASSWORD=replace_with_local_admin_pwd
PG_READONLY_USER=readonly_analyst
PG_READONLY_PASSWORD=replace_with_local_ro_pwd

# === 4. 运行守卫与预算上限 ===
MAX_AGENT_STEPS=12
MAX_NODE_RETRIES=3
MAX_TOKENS_PER_RUN=60000
SANDBOX_TIMEOUT_SECONDS=30

# === 5. 可观测性（默认写入本地 ./traces JSONL；可选开启 Arize Phoenix 或 Langfuse Cloud）===
TRACE_DIR=./traces
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
